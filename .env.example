# ==========================================
# Periscope - Environment Variables
# ==========================================

# Application Settings
PORT=8006
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8006

# Security Keys
# Generate using `openssl rand -base64 32`
JWT_SECRET=super_secret_jwt_key_example
AES_ENCRYPTION_KEY=super_secret_aes_32_byte_key_ex

# PostgreSQL Database (Metadata, Users, Projects)
DB_HOST=postgres
DB_PORT=5432
DB_USER=periscope
DB_PASSWORD=secret
DB_NAME=periscope_db
DB_SSLMODE=disable

# MinIO / S3 Storage (Parquet files)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=periscope-telemetry
S3_REGION=us-east-1
S3_USE_SSL=false
